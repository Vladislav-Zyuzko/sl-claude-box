# ─── Claude Code ───────────────────────────────
# OAuth-токен Claude Code (claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=

# Версия Claude Code в образе воркера: latest или точная (напр. 2.1.276) для пина/отката.
# Обновление: docker compose build --build-arg CLAUDE_REFRESH=$(date +%s) claude-worker
CLAUDE_CODE_VERSION=latest

# Модель Nexus и его субагентов. Меняется на лету командой /model в боте,
# здесь — стартовое значение и список для меню ("<id>:<подпись>" через запятую).
NEXUS_MODEL=claude-opus-5
NEXUS_MODELS=claude-opus-5:Opus 5,claude-sonnet-5:Sonnet 5,claude-fable-5-1:Fable 5.1,claude-haiku-4-5-20251001:Haiku 4.5
# 1 — навязать модель всем субагентам, игнорируя model: в их frontmatter
NEXUS_SUBAGENT_MODEL_FORCE=

# ─── Telegram bot ──────────────────────────────
TELEGRAM_BOT_TOKEN=
# ID разрешённых пользователей через запятую
ALLOWED_USER_IDS=

# ─── GitHub / sweet_limit ──────────────────────
# Fine-grained PAT с доступом к Tsezia/sweet_limit:
#   Contents: Read and write, Pull requests: Read and write
GITHUB_TOKEN=

# Откуда тянуть проект и какая ветка базовая (есть дефолты в docker-compose)
SWEET_LIMIT_REPO=https://github.com/Tsezia/sweet_limit.git
BASE_BRANCH=develop

# Identity, под которой агент коммитит в sweet_limit
GIT_USER_NAME=SLNexus Bot
GIT_USER_EMAIL=slnexus-bot@users.noreply.github.com

# ─── Figma: оффлайн-слепок дизайна ─────────────
# Куда figma-snapshot.sh заливает слепок. Это каталог figma внутри примонтированного
# workspace на сервере (volumes: ./workspace:/workspace). Путь обязан кончаться на /figma.
FIGMA_REMOTE=user@server:/opt/sl-claude-box/workspace/figma
# Локальная папка, куда инструмент dump_design пишет слепок (по умолчанию ./figma-snapshot)
FIGMA_SNAPSHOT_DIR=
# Отдельный SSH-ключ без passphrase — чтобы заливка шла неинтерактивно.
# Создать: ssh-keygen -t ed25519 -N "" -f ~/.ssh/sl_figma_deploy
# и добавить .pub в ~/.ssh/authorized_keys на сервере. Пусто — обычный ключ по умолчанию.
FIGMA_SSH_KEY=~/.ssh/sl_figma_deploy
# Где слепок лежит внутри воркера — менять незачем, если не переехал volume
NEXUS_FIGMA_DIR=/workspace/figma
