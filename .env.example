# ─── Claude Code ───────────────────────────────
# OAuth-токен Claude Code (claude setup-token)
CLAUDE_CODE_OAUTH_TOKEN=

# ─── Telegram bot ──────────────────────────────
TELEGRAM_BOT_TOKEN=
# ID разрешённых пользователей через запятую
ALLOWED_USER_IDS=

# ─── GitHub / sweet_limit ──────────────────────
# Fine-grained PAT с доступом к Tsezia/sweet_limit:
#   Contents: Read and write, Pull requests: Read and write
GITHUB_TOKEN=

# Откуда тянуть проект и какая ветка базовая (есть дефолты в docker-compose)
SWEET_LIMIT_REPO=https://github.com/Tsezia/sweet_limit.git
BASE_BRANCH=develop

# Identity, под которой агент коммитит в sweet_limit
GIT_USER_NAME=SLNexus Bot
GIT_USER_EMAIL=slnexus-bot@users.noreply.github.com
