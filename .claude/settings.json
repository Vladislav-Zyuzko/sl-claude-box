{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./ssh-key)",
      "Read(./ssh-key.pub)",
      "Read(./.ssh/**)",
      "Read(./**/.ssh/**)",
      "Read(./ssh-keys/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_ed25519)",
      "Read(./**/id_ed25519.pub)",
      "Read(./**/id_rsa)",
      "Read(./**/id_rsa.pub)"
    ]
  }
}
